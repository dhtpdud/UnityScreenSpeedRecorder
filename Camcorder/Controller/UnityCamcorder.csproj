<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UnityCamcorder</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 어떤 PC에서도 .NET 설치 없이 실행되도록 단일 파일 자체 포함 배포 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 파일 속성에 표시되는 정보 (제조사·설명이 비어 있으면 백신 오탐이 늘어남) -->
    <Version>1.1.0</Version>
    <Company>UnityCamcorder (github.com/dhtpdud/UnityScreenSpeedRecorder)</Company>
    <Product>UnityCamcorder - Unity app speed recorder</Product>
    <Copyright>Copyright (C) dhtpdud</Copyright>
    <Description>UnityCamcorder recorder: records Unity apps chosen by the user and encodes video with ffmpeg</Description>
  </PropertyGroup>

</Project>
