// Version information for the UnityCamcorder executables/DLL (generated per file by CMake configure_file).
// Small executables with no company/product/description are easily caught by generic (heuristic/ML)
// antivirus detections, so this states exactly what the program is. (ASCII only for rc.exe/windres)
#include <windows.h>

@CAMCORDER_MANIFEST_LINE@
@CAMCORDER_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CAMCORDER_VERSION_COMMA@
 PRODUCTVERSION @CAMCORDER_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @CAMCORDER_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UnityCamcorder (github.com/dhtpdud/UnityScreenSpeedRecorder)"
            VALUE "FileDescription", "@CAMCORDER_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@CAMCORDER_VERSION@"
            VALUE "InternalName", "@CAMCORDER_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) dhtpdud"
            VALUE "OriginalFilename", "@CAMCORDER_ORIGINAL_FILENAME@"
            VALUE "ProductName", "UnityCamcorder - Unity app speed recorder"
            VALUE "ProductVersion", "@CAMCORDER_VERSION@"
            VALUE "Comments", "Open-source screen recorder for Unity apps. Source: https://github.com/dhtpdud/UnityScreenSpeedRecorder"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
